---
import Layout from '../../layouts/Layout.astro';
import { getPublishedPosts } from '../../lib/posts';

const sortedPosts = await getPublishedPosts();

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  }).format(date);
}
---

<Layout
  title="Blog"
  description="Thoughts and articles on software engineering, web development, Remix, and craftsmanship by Scott Smerchek."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <header class="mb-12">
      <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 dark:text-white sm:text-5xl mb-4">
        Blog
      </h1>
      <p class="text-lg text-gray-600 dark:text-gray-300">
        Articles and notes on web development, software engineering, Remix, and more.
      </p>
    </header>

    <div class="space-y-10">
      {sortedPosts.map((post) => (
        <article class="group relative flex flex-col items-start border-b border-gray-200 dark:border-gray-800 pb-10">
          <time
            datetime={post.data.pubDate.toISOString()}
            class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-2"
          >
            {formatDate(post.data.pubDate)}
          </time>

          <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
            <a href={`/blog/${post.id}`}>
              <span class="absolute -inset-x-4 -inset-y-2.5 hidden rounded-2xl bg-gray-50 dark:bg-gray-800/50 sm:block -z-10 group-hover:opacity-100 opacity-0 transition-opacity" />
              {post.data.title}
            </a>
          </h2>

          {post.data.description && (
            <p class="mt-3 text-base text-gray-600 dark:text-gray-300 leading-relaxed">
              {post.data.description}
            </p>
          )}

          {post.data.categories && post.data.categories.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-2">
              {post.data.categories.map((cat) => (
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400">
                  #{cat}
                </span>
              ))}
            </div>
          )}

          <div class="mt-4 flex items-center text-sm font-semibold text-indigo-600 dark:text-indigo-400 group-hover:underline">
            Read article &rarr;
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>
