---
// Footer.astro
const year = new Date().getFullYear();
---

<footer class="border-t border-gray-200 dark:border-gray-800 py-10 mt-auto transition-colors">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-gray-500 dark:text-gray-400">
    <p>&copy; {year} Scott Smerchek. All rights reserved.</p>
    <div class="flex items-center space-x-6">
      <a
        href="https://github.com/smerchek"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-gray-900 dark:hover:text-gray-200 transition-colors"
      >
        GitHub
      </a>
      <a
        href="https://twitter.com/smerchek"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-gray-900 dark:hover:text-gray-200 transition-colors"
      >
        Twitter / X
      </a>
      <a
        href="/rss.xml"
        class="hover:text-gray-900 dark:hover:text-gray-200 transition-colors flex items-center gap-1"
      >
        <svg class="w-4 h-4 text-orange-500" fill="currentColor" viewBox="0 0 20 20">
          <path d="M5 3a1 1 0 000 2c5.523 0 10 4.477 10 10a1 1 0 102 0C17 8.373 11.627 3 5 3z" />
          <path d="M4 9a1 1 0 011-1 7 7 0 017 7 1 1 0 11-2 0 5 5 0 00-5-5 1 1 0 01-1-1zM3 15a2 2 0 114 0 2 2 0 01-4 0z" />
        </svg>
        RSS
      </a>
    </div>
  </div>
</footer>
