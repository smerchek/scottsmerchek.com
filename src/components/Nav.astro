---
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname;

const navigation = [
  { name: 'Home', href: '/' },
  { name: 'Blog', href: '/blog' },
  { name: 'About', href: '/about' },
];

function isActive(href: string) {
  if (href === '/') {
    return pathname === '/';
  }
  return pathname === href || pathname.startsWith(href + '/');
}
---

<nav class="bg-white/80 dark:bg-gray-900/80 backdrop-blur-md sticky top-0 z-50 border-b border-gray-200 dark:border-gray-800 transition-colors">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 justify-between items-center">
      <div class="flex items-center">
        <a href="/" class="flex flex-shrink-0 items-center group">
          <span class="text-lg font-semibold text-gray-800 dark:text-gray-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
            Scott <span class="hidden sm:inline-block">Smerchek</span>
          </span>
        </a>
        <div class="ml-8 flex space-x-6">
          {navigation.map((item) => {
            const active = isActive(item.href);
            return (
              <a
                href={item.href}
                class:list={[
                  'inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium transition-colors',
                  active
                    ? 'border-indigo-500 text-gray-900 dark:text-white font-semibold'
                    : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 dark:hover:border-gray-600'
                ]}
              >
                {item.name}
              </a>
            );
          })}
        </div>
      </div>
      <div class="flex items-center space-x-4">
        <ThemeToggle />
      </div>
    </div>
  </div>
</nav>
